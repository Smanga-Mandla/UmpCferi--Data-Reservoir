DJANGO_SECRET_KEY=replace-with-a-random-secret-before-use
MFA_ENCRYPTION_KEY=optional-fernet-key-for-independent-mfa-secret-encryption
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# For Neon, set DATABASE_URL to the connection string copied from Neon.
# Keep the secret string local; use the pooled connection string for the web app.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0

# Local PostgreSQL fallback when DATABASE_URL is blank:
POSTGRES_DB=umpCferi
POSTGRES_USER=replace-with-your-postgres-user
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

 
# Use localhost HTTP only for development; production settings require HTTPS.
DJANGO_PUBLIC_BASE_URL=http://127.0.0.1:8000
INCUBATEE_CHECKIN_SEND_DAY=1
INCUBATEE_CHECKIN_DEADLINE_DAY=15
INCUBATEE_CHECKIN_REMINDER_DAYS=
INCUBATEE_CHECKIN_STATUSES=active
INCUBATEE_CHECKIN_LINK_MAX_AGE_SECONDS=2592000

LOG_LEVEL=INFO
